// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  OPEN
  ACCEPTED
  PICKED_UP
  COMPLETED
  RECEIVED
  CANCELED
  EXPIRED
  FAILED
  PENDING_RESERVATION // Credit service is reserving the credits
  RESERVATION_FAILED // Credit service failed to reserve the credits, so the order creation fails.
  AUTO_RECEIVED // System automatically marked order as received 30 minutes after courier completion
  AUTO_FAILED // System automatically marked order as failed when expiryAt is reached and the order is not completed yet.
}

enum OrderEventType {
  RESERVE_CREDITS // Request credit service to reserve the credits
  ORDER_OPENED // Notify users of new orders
  ORDER_CANCELED // Credit service release the reserved credits
  ORDER_COMPLETED // Notify requester of order completion
  ORDER_EXPIRED // Credit service release the reserved credits
  ORDER_RECEIVED // Credit service transfer the credits to the courier
  ORDER_FAILED // Credit service release the reserved credits
}

enum OutboxEventStatus {
  PENDING // Waiting to be processed by the outbox publisher
  PROCESSING // Claimed by the outbox publisher and being processed
  PUBLISHED
  DEAD
}

enum CreditReservationResultType {
  CREDIT_RESERVATION_SUCCEEDED
  CREDIT_RESERVATION_FAILED
}

model Order {
  id String @id @default(uuid()) @db.Uuid

  // IDs owned by user service
  requesterId String  @db.Uuid
  courierId   String? @db.Uuid

  // Order request details
  name        String @db.VarChar(255)
  description String @db.VarChar(500)

  // IDs owned by supplier service
  pickupSupplierId   String @db.Uuid
  deliverySupplierId String @db.Uuid

  offeredCredits Int

  // Optional remarks from requester
  remarks String? @db.Text

  // Lifecycle 
  status   OrderStatus @default(OPEN)
  expiryAt DateTime    @db.Timestamptz(6)

  // Optimistic concurrency control
  version Int @default(1)

  // General timestamps
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  acceptedAt  DateTime? @db.Timestamptz(6)
  pickedUpAt  DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  receivedAt  DateTime? @db.Timestamptz(6)
  canceledAt  DateTime? @db.Timestamptz(6)
  expiredAt   DateTime? @db.Timestamptz(6)
  failedAt    DateTime? @db.Timestamptz(6)

  // Reasons
  cancellationReason String? @db.Text
  failureReason      String? @db.Text

  // Used to track the reserved credits for this order
  creditReservationId    String? @unique @db.Uuid
  reservationFailureCode String? @db.Text

  // Used to track the renewal of this order
  renewalPending     Boolean @default(false)
  renewalFailureCode String? @db.VarChar(255)

  // Relationships
  statusHistory OrderStatusHistory[]
  outboxEvents  OutboxEvent[]

  // Browse open orders
  @@index([status, expiryAt])
  // Requester history for status and createdAt
  @@index([requesterId, status, createdAt])
  @@index([requesterId, status, expiryAt])
  // Courier history for status and createdAt
  @@index([courierId, status, createdAt])
  @@index([courierId, status, expiryAt])
  // For auto-receival of orders
  @@index([status, completedAt])
}

model OrderStatusHistory {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid

  fromStatus OrderStatus?
  toStatus   OrderStatus

  // ID of the user who caused the transition.
  // NULL for system-generated transitions such as expiry.
  changedBy String? @db.Uuid

  reason String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OutboxEvent {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid

  status    OutboxEventStatus @default(PENDING)
  eventType OrderEventType

  // Actual event payload to be published to RabbitMQ
  payload Json

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // NULL means it has not successfully been published
  publishedAt DateTime? @db.Timestamptz(6)

  nextAttemptAt DateTime? @default(now()) @db.Timestamptz(6)

  lockedUntil DateTime? @db.Timestamptz(6)

  // For error handling
  retryCount Int @default(0)

  // Last error message from RabbitMQ
  lastError String? @db.Text

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt])
  @@index([orderId])
}

model CreditReservationResultInbox {
  eventId       String                      @id @db.Uuid
  correlationId String                      @db.Uuid // Correlation ID from the credit service to identify the request
  eventType     CreditReservationResultType
  payload       Json
  processedAt   DateTime                    @default(now()) @db.Timestamptz(6)

  @@index([correlationId])
}
