# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Server -----------------------------------------------
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# ---- Database -----------------------------------------------
DATABASE_URL="postgresql://username:password@localhost:5432/suppliers?sslmode=require"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# ---- Auth / JWT -----------
JWT_PUBLIC_KEY_PATH=your_public_key_path_here

# ---- Image storage -----------------------------------------------
# These are required variables. STORAGE must be either filled with "s3" or "local", 
# depending on whether you are running the application on cloud or localhost. 
# ASSETS_PUBLIC_URL is the base URL of returned images.
STORAGE=local
ASSETS_PUBLIC_URL=

# When STORAGE=s3, the below 3 fields are required. 
S3_BUCKET=
AWS_REGION=

# Internal Order integration (private ingress only; HTTPS/TLS in deployment)
ORDER_SUPPLIER_SERVICE_TOKEN="replace-with-a-random-service-secret"