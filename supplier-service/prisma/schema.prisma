generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SupplierStatus {
  ACTIVATED
  DEACTIVATED
}

enum Day {
  MONDAY 
  TUESDAY
  WEDNESDAY
  THURSDAY 
  FRIDAY 
  SATURDAY
  SUNDAY
}

model SupplierType { // initial data should include types "RETAIL", "FOOD", "FACILITIES"
  id String @id @default(uuid())
  type String @unique
  suppliers Supplier[]

  @@index([type])
}

model Supplier {
  id String @id @default(uuid())
  name String @unique
  type String
  status SupplierStatus @default(ACTIVATED)
  building String
  floor String
  description String
  address String
  openingHours OpeningHours[]
  latitude Float?
  longitude Float?
  imageUrl String? @default("/images/LocationImagePlaceholder.jpg")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplierType SupplierType @relation(fields: [type], references: [type], onDelete: Cascade)
}

model OpeningHours {
  id String @id @default(uuid()) // primary key for the opening hours table
  supplierId String
  day Day
  openingTime DateTime @db.Time(0)
  closingTime DateTime @db.Time(0)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}