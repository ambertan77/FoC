FRONTEND_PORT=5173
# Public browser-facing URLs, embedded at build time. Never put secrets in VITE_*.
# we no longer want to call the individual services directly from the browser
# route everything to just /api; endpoints.ts will add /auth, /supplier etc
VITE_AUTH_API_BASE_URL=/api
VITE_SUPPLIER_API_BASE_URL=/api
VITE_ORDER_API_BASE_URL=/api
VITE_CREDIT_API_BASE_URL=/api
VITE_NOTIFICATION_API_BASE_URL=/api