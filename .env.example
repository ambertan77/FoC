# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# This root file is read only by the root Compose files
# (compose.yaml, compose.prod.yaml). Each service and the frontend
# read their own `<folder>/.env`; see that folder's .env.example.
# ─────────────────────────────────────────────────────────────

# ---- Local RabbitMQ (root Compose configuration) -----------
# Development defaults only. Match these credentials in the RABBITMQ_URL
# of user-service, order-service and credit-service.
# These initialize a fresh broker volume, not existing broker users.
RABBITMQ_USER=foc
RABBITMQ_PASSWORD=foc-local-only

# ---- Grafana (centralized logging) ---------------------------
# Grafana listens on 127.0.0.1:3030 only. The local default password is
# fine for development. Production REQUIRES a real GRAFANA_ADMIN_PASSWORD:
# either in the EC2 host's .env, or as the GitHub secret of the same name,
# which the deploy copies into .env when it is missing. The deploy fails
# without one. Use letters and digits only (no $, #, quotes or spaces).
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=

# ---- Production server only (compose.prod.yaml) ------------
# Set in the .env on the EC2 host, not locally.
# ECR_REGISTRY: <account-id>.dkr.ecr.<region>.amazonaws.com
# IMAGE_TAG is written by the deploy workflow on each deploy.
# ECR_REGISTRY=
# IMAGE_TAG=

# ---- User service: optional first-admin bootstrap -----------
# Configure in user-service/.env or its deployment environment.
# Leave all empty to disable; remove credentials after success.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PHONE_NUMBER=
BOOTSTRAP_ADMIN_PASSWORD=
