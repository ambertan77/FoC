# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Server -----------------------------------------------
# These addresses are for notification-service running in the root Compose stack.
PORT=3004
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# ---- Database -----------------------------------------------
NOTIFICATION_POSTGRES_DB=notifications
NOTIFICATION_POSTGRES_USER=foc_notification
NOTIFICATION_POSTGRES_PASSWORD=your_postgres_password
# Keep the credentials and database name below in sync with NOTIFICATION_POSTGRES_*.
# Percent-encode special characters in URL credentials.
DATABASE_URL="postgresql://foc_notification:your_postgres_password@notification-postgres:5432/notifications?sslmode=disable"

# ---- RabbitMQ ---------------------------------------------
# Used by the notification outbox publisher. Match the root RabbitMQ credentials.
# Percent-encode special characters in URL credentials.
RABBITMQ_URL="amqp://foc:foc-local-only@rabbitmq:5672?heartbeat=20"

# ---- Auth / JWT -----------
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem

MAX_STREAMS_PER_USER = 8;